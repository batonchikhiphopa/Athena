# Athena production-style local config example.
# Copy this file to .env and adjust values for your machine.

# Server
NODE_ENV=production
ATHENA_HOST=127.0.0.1
PORT=3000

# Paths
# Local production run from repo root:
ATHENA_PROJECT_ROOT=.
ATHENA_CLIENT_DIST_DIR=./client/dist

# SQLite
ATHENA_DATA_DIR=./data
# ATHENA_DATABASE_PATH=./data/athena.db

# Auth
# For a real self-hosted instance, true is recommended.
# For local smoke testing, false can be useful if auth setup blocks you.
ATHENA_AUTH_REQUIRED=true

# Extraction provider
# Options usually used by Athena: ollama, gemini, off.
ATHENA_AI_PROVIDER=off
# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_REQUEST_TIMEOUT_MS=30000

# Gemini optional config.
# To use Gemini, set ATHENA_AI_PROVIDER=gemini and provide a key.
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_REQUEST_TIMEOUT_MS=30000
