{
  "name": "athena",
  "version": "0.9.3",
  "type": "module",
  "author": "batonchikhiphopa",
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "client"
  ],
  "scripts": {
    "server:build": "node -e \"require('node:fs').rmSync('dist/server',{recursive:true,force:true})\" && tsc -p tsconfig.server.build.json",
    "build": "npm run client:build && npm run server:build",
    "start": "node dist/server/server/server.js",
    "audit": "npm audit --workspaces",
    "client:build": "npm --workspace athena-client run build",
    "client:dev": "npm --workspace athena-client run dev",
    "dev": "tsx server/server.ts",
    "db:check": "tsx server/db/check.ts",
    "db:reset": "tsx server/db/reset.ts",
    "docs:codemap": "node scripts/generate-code-map.mjs",
    "lint": "npm --workspace athena-client run lint",
    "release:check": "npm test && npm run server:check && npm run lint && npm run build && npm run test:e2e && npm run audit",
    "server:check": "tsc -p tsconfig.server.json --noEmit",
    "test": "tsx --test test/*.test.js",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "express": "^4.22.2",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/express": "^4.17.25",
    "@types/node": "^24.12.4",
    "fake-indexeddb": "^6.2.5",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
