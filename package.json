{
  "name": "athena",
  "version": "0.6.0",
  "type": "module",
  "author": "batonchikhiphopa",
  "scripts": {
    "audit": "npm audit && npm --prefix client audit",
    "client:build": "npm --prefix client run build",
    "client:dev": "npm --prefix client run dev",
    "dev": "tsx server/server.ts",
    "lint": "npm --prefix client run lint",
    "migrate": "tsx server/db/migrate.ts",
    "release:check": "npm test && npm run server:check && npm run lint && npm run client:build && npm run audit",
    "server:check": "tsc -p tsconfig.server.json --noEmit",
    "test": "tsx --test"
  },
  "dependencies": {
    "argon2": "^0.44.0",
    "express": "^4.22.2",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^24.12.4",
    "fake-indexeddb": "^6.2.5",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
